SQL> DECLARE
  2      CURSOR c_student IS
  3          SELECT Id, fname, lname, city
  4          FROM school_stud;
  5  
  6      v_id    school_stud.Id%TYPE;
  7      v_fname school_stud.fname%TYPE;
  8      v_lname school_stud.lname%TYPE;
  9      v_city  school_stud.city%TYPE;
 10  
 11  BEGIN
 12      OPEN c_student;
 13  
 14      IF c_student%ISOPEN THEN
 15          DBMS_OUTPUT.PUT_LINE('Cursor is OPEN');
 16      END IF;
 17  
 18      LOOP
 19          FETCH c_student
 20          INTO v_id, v_fname, v_lname, v_city;
 21  
 22          IF c_student%NOTFOUND THEN
 23              DBMS_OUTPUT.PUT_LINE('No more records found.');
 24              EXIT;
 25          END IF;
 26  
 27          DBMS_OUTPUT.PUT_LINE(
 28              v_id || ' ' || v_fname || ' ' ||
 29              v_lname || ' ' || v_city
 30          );
 31      END LOOP;
 32  
 33      CLOSE c_student;
 34  
 35      IF NOT c_student%ISOPEN THEN
 36          DBMS_OUTPUT.PUT_LINE('Cursor is CLOSED');
 37      END IF;
 38  
 39  END;
 40  /
