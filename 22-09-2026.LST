SQL> CREATE OR REPLACE PROCEDURE display_school_students
  2  IS
  3      CURSOR c_student IS
  4          SELECT Id, fname, lname, city
  5          FROM school_stud;
  6  
  7      v_id    school_stud.Id%TYPE;
  8      v_fname school_stud.fname%TYPE;
  9      v_lname school_stud.lname%TYPE;
 10      v_city  school_stud.city%TYPE;
 11  BEGIN
 12      OPEN c_student;
 13  
 14      LOOP
 15          FETCH c_student
 16          INTO v_id, v_fname, v_lname, v_city;
 17  
 18          EXIT WHEN c_student%NOTFOUND;
 19  
 20          DBMS_OUTPUT.PUT_LINE(
 21              'ID: ' || v_id ||
 22              ', Name: ' || v_fname || ' ' || v_lname ||
 23              ', City: ' || v_city
 24          );
 25      END LOOP;
 26  
 27      CLOSE c_student;
 28  END;
 29  /

Procedure created.

